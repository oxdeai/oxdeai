{
  "name": "@oxdeai/cli",
  "version": "0.3.1",
  "description": "Protocol-focused CLI tooling for OxDeAI artifact build, verification, and inspection workflows",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "oxdeai": "dist/main.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oxdeai/oxdeai.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/oxdeai/oxdeai",
  "bugs": {
    "url": "https://github.com/oxdeai/oxdeai/issues"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dependencies": {
    "@oxdeai/core": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.json && node scripts/postbuild.mjs",
    "cli": "node dist/main.js",
    "start": "node dist/main.js",
    "prepack": "pnpm build",
    "test": "pnpm build && node --test \"dist/**/*.test.js\""
  }
}
